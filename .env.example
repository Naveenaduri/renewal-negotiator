# Fallback if Omnara streaming isn't working:
ANTHROPIC_API_KEY=

OMNARA_ORG_ID=
OMNARA_PROJECT_ID=
FREESTYLE_API_KEY=
PRIMITIVE_API_KEY=
APP_URL=http://localhost:3000

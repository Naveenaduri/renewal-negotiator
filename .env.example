NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OMNARA_API_KEY=
# Context.dev: server-only secret, never prefix with NEXT_PUBLIC_. Keys: https://www.context.dev/dashboard/api-keys
# Vercel: `vercel env add CONTEXT_DEV_API_KEY`
CONTEXT_DEV_API_KEY=
# Optional: max in-flight Context.dev requests per server instance (Free plan allows 2 concurrent).
# CONTEXT_DEV_MAX_CONCURRENCY=2
# Fallback if Omnara streaming isn't working:
ANTHROPIC_API_KEY=

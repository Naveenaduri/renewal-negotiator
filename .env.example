# Copy to .env.local (local dev) and add to Vercel: `vercel env add CONTEXT_DEV_API_KEY`
# Server-only secret — never prefix with NEXT_PUBLIC_. Keys: https://www.context.dev/dashboard/api-keys
CONTEXT_DEV_API_KEY=ctxt_secret_...

# Optional: max in-flight Context.dev requests per server instance (Free plan allows 2 concurrent).
# CONTEXT_DEV_MAX_CONCURRENCY=2
